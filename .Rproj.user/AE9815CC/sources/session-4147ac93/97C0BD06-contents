# Zero Dose and Under vaccinated children

```{r Zero dose vaccinated}
Zero_dose <- dat_national %>%
  group_by(regions) %>%
  summarise(
    zerodoside = suppressWarnings(sum(as.numeric(zerodoside), na.rm = TRUE)),
    zero_vacina = suppressWarnings(sum(as.numeric(zero_vacina), na.rm = TRUE)),
    undervacciniden = suppressWarnings(sum(as.numeric(undervacciniden), na.rm = TRUE)),
    undervaccilin = suppressWarnings(sum(as.numeric(undervaccilink), na.rm = TRUE))
  )
combined_long <- Zero_dose %>%
  pivot_longer(
    cols = c(zerodoside, zero_vacina, undervacciniden, undervaccilin),
    names_to = "measure", values_to = "count"
  ) %>%
  mutate(measure = recode(measure,
    zerodoside = "Zero-dose Identified",
    zero_vacina = "Zero-dose Vaccinated",
    undervacciniden = "Under-vacc Identified",
    undervaccilin = "Under-vacc Vaccinated"
  ))

ggplot(combined_long, aes(x = reorder(regions, -count), y = count, fill = measure)) +
  geom_col(position = "stack", width = 0.7, color = "white", linewidth = 0.2) +
  scale_fill_manual(values = c(
    "Zero-dose Identified" = "#e34a33",
    "Zero-dose Vaccinated" = "#2c7fb8",
    "Under-vacc Identified" = "#fdae61",
    "Under-vacc Vaccinated" = "#31a354"
  )) +
  labs(
    title = "Zero-Dose and Under-Vaccinated Children by Region",
    subtitle = "Identified vs. Vaccinated, by region",
    x = "Region", y = "Number of children", fill = "Measure",
    caption = "Source: Ethiopian Public Health Institute, PHEM"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(face = "bold", size = 15),
    plot.subtitle = element_text(size = 10, color = "grey40"),
    plot.caption = element_text(size = 8, color = "grey50"),
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "right",
    legend.title = element_text(face = "bold"),
    panel.grid.minor = element_blank()
  )

