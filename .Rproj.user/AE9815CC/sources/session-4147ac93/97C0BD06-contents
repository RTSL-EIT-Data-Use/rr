# nOPV2 Vaccination status by age group 
- Majority of children had received at least one dose of polio vaccine before the campaign.
- Children identified had not been reached through routine immunization 
Potential immunity gap: These children may have limited or no prior immunity against polio virus.
 - The campaign can identify and vaccinate children who are missed by routine immunization.
 - Link children identified as missed by routine immunization to routine vaccination services.
 - The focus should not only be on the number vaccinated, but also on identifying and closing immunity gaps among previously un reached children.

```{r,}
Age_vaccination <- dat_national %>%
  summarise(across(
    .cols = matches("0-11.*vac|12-59.*vac|0-11vac|12-59vac"), 
    .fns = ~sum(., na.rm = TRUE)
  )) %>% 
  pivot_longer(everything(), names_to = "Category", values_to = "Count") %>% 
  mutate(Full_Category = case_when(
      str_detect(Category, "0.*11") & str_detect(Category, "not|un") ~ "0-11 Months\nNot Vaccinated Before",
      str_detect(Category, "0.*11") ~ "0-11 Months\nVaccinated Before",
      str_detect(Category, "12.*59") & str_detect(Category, "not|un") ~ "12-59 Months\nNot Vaccinated Before",
      TRUE ~ "12-59 Months\nVaccinated Before"
    )
  )

# 2. Plot all 4 categories separately on the X-axis
ggplot(Age_vaccination, aes(x = Full_Category, y = Count, fill = Full_Category)) +
  geom_col(width = 0.6) +
  # Custom colors for each individual category bar
  scale_fill_manual(values = c(
    "0-11 Months\nVaccinated Before"     = "#0055A5", 
    "0-11 Months\nNot Vaccinated Before" = "#3498DB",
    "12-59 Months\nVaccinated Before"    = "#E74C3C", 
    "12-59 Months\nNot Vaccinated Before"= "#F1C40F"
  )) +
  scale_y_continuous(labels = scales::comma) +
  theme_minimal() +
  labs(
    title = "nOPV2 vacciantion based on the previous vaccination status", 
    y = "Children Reached", 
    x = ""
  ) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    legend.position = "none", 
    axis.text.x = element_text(face = "bold", size = 10))


```

# Vaccine utilization

 - Oromia and Amhara region handled the highest volumes of nOPV2 vaccines, dominating "Received," "Used," and "Partially Used" counts.
 - Regions such as Harari, Dire Dawa, and South Ethiopia maintain very low counts across all seven metrics. This indicates limited campaign scale in these specific areas.

```{r Number of children vaccinated by age , echo=FALSE, warning=FALSE, message=FALSE}
dat_vaccine <- dat_national %>%
  select(regions, nOPV2vrec, nOPV2vuse, nOPV2retur, nOPV2vbad, nOPV2vlost, nOPV2paruse, nOPV2brok) %>%
  group_by(regions) %>%
  summarise(
    across(starts_with("nOPV2"), ~ sum(.x, na.rm = TRUE)),
    .groups = "drop"
  )
dat_vaccinate2 <- dat_vaccine %>%
  pivot_longer(
    cols = starts_with("nOPV2"),     
    names_to = "vaccine_status",     
    values_to = "count"
  ) %>%                  # <-- The pipe must sit exactly here at the line break!
  mutate(
    vaccine_status = case_when(
      vaccine_status == "nOPV2vrec"   ~ "1. Received Doses",
      vaccine_status == "nOPV2vuse"   ~ "2. Used Doses",
      vaccine_status == "nOPV2retur"  ~ "3. Returned Doses",
      vaccine_status == "nOPV2vbad"   ~ "4. Bad Condition",
      vaccine_status == "nOPV2vlost"  ~ "5. Lost Doses",
      vaccine_status == "nOPV2paruse" ~ "6. Partially Used",
      vaccine_status == "nOPV2brok"   ~ "7. Broken Doses",
      TRUE ~ vaccine_status 
    )
  )

#  Generate the chart
ggplot(data = dat_vaccinate2, mapping = aes(x = count, y = regions, fill = regions)) +
  geom_col(show.legend = FALSE) +
  facet_wrap(~vaccine_status, scales = "free_x") + 
  scale_x_continuous(labels = scales::label_comma()) +
  theme_minimal()

